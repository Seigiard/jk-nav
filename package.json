{
  "name": "jk-nav",
  "version": "1.0.0",
  "description": "Navigate pages using vim-style keyboard shortcuts.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
